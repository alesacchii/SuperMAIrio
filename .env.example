# Copy to .env. The process environment overrides this file.

# The model under test: full URL of a Decisions-compatible endpoint and the model ID it serves.
# The key is optional and sent as a Bearer token only to this endpoint.
SUPERMAIRIO_ENDPOINT=
SUPERMAIRIO_MODEL=
SUPERMAIRIO_API_KEY=

# A participant on a second endpoint, enabled in benchmark.toml with env_prefix = "SUPERMAIRIO_LOCAL".
# SUPERMAIRIO_LOCAL_ENDPOINT=http://127.0.0.1:8000/decisions
# SUPERMAIRIO_LOCAL_MODEL=local-model
# SUPERMAIRIO_LOCAL_API_KEY=

