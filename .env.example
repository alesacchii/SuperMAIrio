# Copy to .env and add your OpenRouter key: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Optional: model to use. The default is decider, the one with the best results.
# A value here is overridden by the --model option. Available models:
#   decider  -> perplexity/pplx-decider-v1.2
#   d1       -> liquid/d1.1
#   gpt_luna -> openai/gpt-6-luna-decisions
#   jev      -> typesafe/jev-1.14
# OPENROUTER_MODEL=decider
