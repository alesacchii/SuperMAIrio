# Copy to .env and supply your own OpenRouter key.
OPENROUTER_API_KEY=
# Module name or OpenRouter model ID. CLI --model overrides this;
# without a value the default is GPT Luna. Available models:
#   gpt_luna -> openai/gpt-6-luna-decisions
#   jev      -> typesafe/jev-1.14
#   decider  -> perplexity/pplx-decider-v1.2
#   d1       -> liquid/d1.1
OPENROUTER_MODEL=typesafe/jev-1.14
